# Production environment for ShopOps — copy to .env.prod on the EC2 box
# and fill in real values. This file itself is NOT the real secrets file
# and is safe to commit (see .env.prod in .gitignore).

# RDS Postgres endpoint. NOTE: the app reads LOCAL_DATABASE_URL (not
# DATABASE_URL) for this — see app/config.py. RDS requires SSL, hence
# ?sslmode=require (matches scripts/apply_migration.py's hardcoded
# sslmode="require" for RDS connections).
LOCAL_DATABASE_URL=postgresql+psycopg2://shopops_admin:<RDS_MASTER_PASSWORD>@<RDS_ENDPOINT>:5432/shopops?sslmode=require
DATABASE_URL=postgresql+psycopg2://shopops_admin:<RDS_MASTER_PASSWORD>@<RDS_ENDPOINT>:5432/shopops?sslmode=require

# Qdrant runs as the `qdrant` service on the same Docker network.
QDRANT_URL=http://qdrant:6333

# AWS Cognito (from infra/scripts/05_create_cognito.sh output)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>
COGNITO_APP_CLIENT_ID=<COGNITO_APP_CLIENT_ID>

# Google Gemini (LiteLLM) - agent orchestrator
GEMINI_API_KEY=<your-gemini-api-key>
AGENT_MODEL=gemini/gemini-3.1-flash-lite

# Frontend origin allowed to call this API. This must be the actual
# deployed frontend's origin (e.g. wherever shop-ops-ai-frontend/ ends up
# hosted — Vercel, etc.), NOT the EC2 Elastic IP — nginx here proxies
# straight to the API and doesn't serve the frontend at all.
CORS_ORIGINS=https://<your-frontend-origin>

# The API's own public URL as seen by browsers — used by the frontend's
# NEXT_PUBLIC_API_BASE_URL, not read by this app itself. If you're using
# nginx/generate-letsencrypt-cert.sh (free nip.io + Let's Encrypt, no
# domain purchase needed), this is https://<ip-with-dashes>.nip.io, not
# the raw IP — that's what makes the cert trusted so testers don't need
# to click through a browser warning first.

LOG_LEVEL=INFO
