POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=shopops
POSTGRES_USER=shopops_admin
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+psycopg2://shopops_admin:changeme@localhost:5433/shopops

LOCAL_DATABASE_URL=postgresql+psycopg2://shopops_admin:changeme@localhost:5433/shopops

# Qdrant (local Docker; no auth needed for local dev)
QDRANT_URL=http://localhost:6333

# AWS Cognito
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=changeme

# IAM user with AmazonCognitoPowerUser — used only for local test-token retrieval
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Cognito test users (one per role)
COGNITO_TEST_VIEWER_EMAIL=changeme
COGNITO_TEST_VIEWER_PASSWORD=changeme
COGNITO_TEST_SUPPORT_EMAIL=changeme
COGNITO_TEST_SUPPORT_PASSWORD=changeme
COGNITO_TEST_MANAGER_EMAIL=changeme
COGNITO_TEST_MANAGER_PASSWORD=changeme
